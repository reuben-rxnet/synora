{
  "name": "synora",
  "version": "0.1.0",
  "private": true,
  "description": "Synora – Enterprise intelligence, connected.",
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev -p 3020",
    "build": "next build",
    "start": "next start -p 3020",
    "worker": "tsx --env-file=.env src/worker/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:up": "docker compose up -d db",
    "db:push": "prisma db push --skip-generate && tsx --env-file=.env scripts/db-indexes.ts",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:reset": "prisma db push --force-reset --skip-generate && tsx --env-file=.env scripts/db-indexes.ts && tsx --env-file=.env prisma/seed.ts",
    "setup": "prisma generate && npm run db:push && npm run db:seed",
    "hda:discover": "tsx --env-file=.env scripts/hda-discover.ts",
    "sync": "tsx --env-file=.env scripts/sync-once.ts",
    "eval": "tsx --env-file=.env scripts/eval.ts"
  },
  "prisma": {
    "seed": "tsx --env-file=.env prisma/seed.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.7.5",
    "@prisma/client": "^6.19.0",
    "clsx": "^2.1.1",
    "next": "^16.3.6",
    "openid-client": "^6.8.1",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
