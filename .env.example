# Synora local settings. Copy to .env. Never commit real secrets; production reads them from Key Vault.
DATABASE_URL=postgresql://synora:synora-local-dev@localhost:5440/synora

# Sign-in: demo (local only, refused in production) or entra
AUTH_PROVIDER=demo
SESSION_SECRET=
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:3020/api/auth/callback

# AI: mock (deterministic, no external calls) or openai (Codex through the EssilorLuxottica APIM gateway)
AI_PROVIDER=mock
OPENAI_BASE_URL=https://dev-apim-ai.luxottica.com/codex/openai/v1
OPENAI_MODEL=gpt-5.3-codex_codeassist
OPENAI_API_STYLE=RESPONSES
OPENAI_AUTH_LOCATION=QUERY_PARAMETER
OPENAI_AUTH_QUERY_PARAMETER=subscription-key
OPENAI_EXTRA_HEADERS=x-openai-supplier: EssilorLuxottica
OPENAI_API_KEY=
LLM_ENDPOINT_ALLOWLIST=dev-apim-ai.luxottica.com
# External AI stays off until the data-processing approval reference is set.
AI_DATA_PROCESSING_APPROVAL_REF=

# Embeddings: local (multilingual-e5-small on this machine, nothing leaves it) or hash (tests only)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/multilingual-e5-small

# HDA (HelpDesk Advanced) – same API and sign-in as CSAT Pulse (D:\Projects\CSAT_HDA)
HDA_BASE_URL=https://helpdeskquality.luxottica.com/HDAPortal
HDA_AUTH_MODE=login
HDA_USERNAME=
HDA_PASSWORD=
HDA_API_KEY=
HDA_SOURCE_APPLICATION=Synora
HDA_MAPPING_FILE=config/hda-mapping.json

# Azure DevOps Boards and wikis (read-only). Local: a PAT with the Work Items (Read) and Wiki (Read) scopes.
# Production: ADO_AUTH_MODE=entra with a service principal added to the organization (reader on work items).
ADO_ORG_URL=https://dev.azure.com/ITRxSolutions
ADO_PROJECT=Rx.Net - Platform
ADO_AUTH_MODE=pat
ADO_PAT=
ADO_TENANT_ID=
ADO_CLIENT_ID=
ADO_CLIENT_SECRET=
ADO_MAPPING_FILE=config/ado-mapping.json

# Worker
WORKER_POLL_MS=3000

# SharePoint & OneDrive (Microsoft Graph, delegated: reads what the signed-in account can read).
# IT registers the app; see README → SharePoint & OneDrive. Falls back to the ENTRA_ values when these are empty.
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_SITE_URL=https://luxotticagroup.sharepoint.com/sites/CentralRxOperationsSupport
M365_MAPPING_FILE=config/m365-mapping.json
# Text recognition languages for images (tesseract codes joined with +, e.g. eng+fra+ita).
OCR_LANGUAGES=eng
